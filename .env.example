# Copy to .dev.vars for local Wrangler. Replace placeholders; never commit .dev.vars.
# Persistent sessions use D1; AUTH_SECRET supports the remaining legacy signing helpers.
AUTH_SECRET=replace-with-a-long-random-local-secret
SEED_TOKEN=replace-with-a-separate-random-local-seed-token
ADMIN_PASSWORD=replace-with-a-unique-admin-password-at-least-12-characters
# Optional local demo student (omit to avoid creating it):
# STUDENT_PASSWORD=replace-with-a-unique-student-password-at-least-12-characters
